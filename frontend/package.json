{
  "name": "@blueskyproject/multimodal-analysis",
  "private": false,
  "version": "0.0.1",
  "type": "module",
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/multimodal.es.js",
      "require": "./dist/multimodal.umd.js"
    },
    "./style.css": "./dist/multimodal.css"
  },
  "main": "./dist/multimodal.umd.js",
  "module": "./dist/multimodal.es.js",
  "scripts": {
    "dev": "vite --config vite.app.config.ts",
    "build": "tsc -b && vite build",
    "build:app": "tsc -b && vite build --config vite.app.config.ts",
    "lint": "eslint .",
    "preview": "vite preview --config vite.app.config.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": ">16.8.x",
    "react-dom": ">16.8.x"
  },
  "dependencies": {
    "@blueskyproject/finch": "^0.1.5",
    "@blueskyproject/tiled": "^0.0.18",
    "@h5web/lib": "^16.0.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "html-to-image": "^1.11.13",
    "lodash": "^4.17.21",
    "msgpackr": "^1.11.8",
    "ndarray": "^1.0.19",
    "react-color": "^2.19.3",
    "react-router-dom": "^6.30.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/lodash": "^4.17.13",
    "@types/ndarray": "^1.0.14",
    "@types/react": "^18.3.17",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.7.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18"
  }
}
